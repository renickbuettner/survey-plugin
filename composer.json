{
    "name": "renick/survey-plugin",
    "type": "october-plugin",
    "description": "A simple survey plugin",
    "homepage": "https://octobercms.com/plugin/renick-survey",
    "keywords": [
        "octobercms-plugin",
        "octobercms",
        "php",
        "poll",
        "survey"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Renick Büttner",
            "email": "complains@renick.io"
        }
    ],
    "require": {
        "php": "^8.0.2",
        "october/rain": "^3.0 || ^4.0",
        "composer/installers": "^1.0 || ^2.0"
    },
    "suggest": {
        "ext-zip": "Needed for the Excel (.xlsx) export, a CSV file is offered without it",
        "renick/content-plugin": "Adds a Survey block to the Content Editor"
    },
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
